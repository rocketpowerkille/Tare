# Optional local directory for public watch-only profiles. No secrets required.
# TARE_HOME=.tare
# Optional read-only Ethereum RPC endpoint for live resolution or wallet balance.
# Set this in your shell; the CLI does not automatically load .env files.
# TARE_RPC_URL=https://ethereum-rpc.publicnode.com
# A distinct provider for the scoped WETH custody cross-check.
# TARE_SECONDARY_RPC_URL=https://rpc.mevblocker.io
# Phase-four live accounting deployment (synced and matched against RPC).
# TARE_GRAPH_URL=https://api.studio.thegraph.com/query/1760123/tare-live-accounting/0.1.0
# TARE_GRAPH_DEPLOYMENT=QmWSiZRvaFzYkohhsM2D9yHD4Nc7ZnZFRWz8pUcwfQi3j2
# The full-history share-ledger deployment remains available at the URL/CID below
# while it backfills. Select it instead when running share verification.
# https://api.studio.thegraph.com/query/1760123/tare-steakhouse-usdc-ethereum/0.1.0
# QmZrGd5mh9V5x57J4ETN9sWVP2P3VMVpRgQ7p5XK9CW1hw
# GRAPH_API_KEY=YOUR_LOCAL_QUERY_KEY_IF_REQUIRED
# Query keys are sent in a header, never saved in verification receipts.
# Local phase-five API and web explorer listen only on 127.0.0.1.
# TARE_PORT=4318
# Optional hosted access behind an HTTPS reverse proxy (all settings stay local).
# Setting either hosted field requires both; keys map client IDs to unique random tokens.
# TARE_PUBLIC_ORIGIN=https://YOUR_TARE_DOMAIN
# TARE_API_KEYS={"client-id":"YOUR_RANDOM_32_TO_128_CHARACTER_BASE64URL_TOKEN"}
# TARE_REQUESTS_PER_MINUTE=60
# The Node server still binds only to loopback. Preserve Host at the reverse proxy.
# Phase-six event monitoring also needs the configured RPC and Graph fields above.
# TARE_SUBSTREAMS_URL=https://mainnet.eth.streamingfast.io
# SUBSTREAMS_API_TOKEN=YOUR_LOCAL_SUBSTREAMS_TOKEN
