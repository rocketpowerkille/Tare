# Optional local directory for public watch-only profiles. No secrets required.
# TARE_HOME=.tare
# Optional read-only Ethereum RPC endpoint for live resolution or wallet balance.
# Set this in your shell; the CLI does not automatically load .env files.
# TARE_RPC_URL=https://ethereum-rpc.publicnode.com
# A distinct provider for the scoped WETH custody cross-check.
# TARE_SECONDARY_RPC_URL=https://rpc.mevblocker.io
# Optional mainnet RPCs used for Morpho V1 and generic ERC-4626 checks.
# TARE_BASE_MAINNET_RPC_URL=https://mainnet.base.org
# TARE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Public vaults to scan directly for non-Morpho ERC-4626 positions. ERC-4626 has
# no global discovery registry, so automatic non-Morpho discovery is bounded by this list.
# TARE_ERC4626_REGISTRY=[{"chainId":84532,"vault":"0x...","name":"Example vault","protocol":"example"}]
# Phase-four live accounting deployment (synced and matched against RPC).
# TARE_GRAPH_URL=https://api.studio.thegraph.com/query/1760123/tare-live-accounting/0.1.0
# TARE_GRAPH_DEPLOYMENT=QmWSiZRvaFzYkohhsM2D9yHD4Nc7ZnZFRWz8pUcwfQi3j2
# The full-history share-ledger deployment remains available at the URL/CID below
# while it backfills. Select it instead when running share verification.
# https://api.studio.thegraph.com/query/1760123/tare-steakhouse-usdc-ethereum/0.1.0
# QmZrGd5mh9V5x57J4ETN9sWVP2P3VMVpRgQ7p5XK9CW1hw
# GRAPH_API_KEY=YOUR_LOCAL_QUERY_KEY_IF_REQUIRED
# Query keys are sent in a header, never saved in verification receipts.
# Local phase-five API and web explorer listen only on 127.0.0.1.
# TARE_PORT=4318
# Keep the default loopback bind locally. A container platform can use 0.0.0.0 only
# together with the complete hosted access configuration below.
# TARE_BIND_HOST=127.0.0.1
# Optional hosted access behind an HTTPS reverse proxy (all settings stay local).
# Setting either hosted field requires both; keys map client IDs to unique random tokens.
# TARE_PUBLIC_ORIGIN=https://YOUR_TARE_DOMAIN
# TARE_API_KEYS={"client-id":"YOUR_RANDOM_32_TO_128_CHARACTER_BASE64URL_TOKEN"}
# TARE_REQUESTS_PER_MINUTE=60
# Optional Bazantic Base Sepolia sandbox access. The client ID must match the
# TARE_API_KEYS entry configured as the Bazantic gateway's upstream credential.
# Mainnet payment access is intentionally not supported by this session flow.
# TARE_BAZANTIC_CLIENT_ID=bazantic
# TARE_BAZANTIC_SESSION_SECRET=YOUR_RANDOM_32_TO_128_CHARACTER_BASE64URL_SECRET
# TARE_BAZANTIC_GATEWAY_URL=https://YOUR_GATEWAY.bazgateway.com
# TARE_BAZANTIC_SESSION_MINUTES=15
# Render deployments use the platform-provided RENDER_EXTERNAL_URL when no custom
# TARE_PUBLIC_ORIGIN is set. Set TARE_PUBLIC_ORIGIN explicitly for a custom domain.
# Preserve the public Host header at the HTTPS ingress.
# Phase-six event monitoring also needs the configured RPC and Graph fields above.
# TARE_SUBSTREAMS_URL=https://mainnet.eth.streamingfast.io
# SUBSTREAMS_API_TOKEN=YOUR_LOCAL_SUBSTREAMS_TOKEN

# Base Sepolia CRE simulation. Copy these values to .env; .env is ignored by Git.
TARE_BASE_RPC_URL=https://sepolia.base.org
TARE_BASE_SECONDARY_RPC_URL=https://base-sepolia-rpc.publicnode.com
TARE_BASE_CUSTODY_DEPLOYMENT='{"outerVault":"0x22ba7da38495e20fe7aafe265ca75e258d7f84b2","innerVault":"0xd4f802c1d09283fc74f4bb52911d0f1d906e7241","terminalAsset":"0xc1b52fd7e7d18cc0b8e1618e8df1a851b96b13a6","codeDigests":{"outerVault":"sha256:793eb5188a1c7c4963a3fe61679d36a714d8fdb000af3035d5f4426245728b0d","innerVault":"sha256:d7efe5d8a3d7964ceb245442aa61e30eef169474b8d6e79821837d88e06537a0","terminalAsset":"sha256:6a744f76184350f29b14b51f67d774874b2f31da9d783ba023d55b2590c217a3"}}'
TARE_PORT=4320
TARE_CRE_API_URL=http://127.0.0.1:4320/api/analyze
SECRET_TARE_PRIVATE_POLICY='{"maxAgeSeconds":300,"maxConcentrationBps":10000,"maxMultipleBps":15000}'
SECRET_TARE_API_TOKEN=tare-local-simulator-token-20260911
# Never commit a real key. This must be the Base Sepolia position owner's 64-hex-character EVM key.
CRE_ETH_PRIVATE_KEY=YOUR_PRIVATE_KEY
