{
  "name": "tare-confidential-policy",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "bun node_modules/@chainlink/cre-sdk/bin/cre-compile.ts src/main.ts ../../.tare/cre/tare-policy.wasm",
    "configure:base-deployment": "node scripts/configure-base-deployment.mjs",
    "configure:hosted": "node scripts/configure-hosted-env.mjs",
    "prepare:e2e": "bun scripts/prepare-base-sepolia-e2e.ts",
    "prepare:hosted": "node scripts/prepare-hosted-config.mjs",
    "prepare:simulation": "bun scripts/prepare-base-sepolia-simulation.ts",
    "test": "cd ../.. && bun test ./workflows/cre/test",
    "verify:hosted": "node scripts/verify-hosted-api.mjs",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.20.1",
    "viem": "2.54.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
